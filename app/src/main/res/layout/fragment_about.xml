<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#FAF7FF"
    tools:context=".ui.about.AboutFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <!-- Foto Profil -->

        <ImageView
            android:id="@+id/imgProfile"
            android:layout_width="120dp"
            android:layout_height="150dp"
            android:layout_marginTop="8dp"
            android:src="@drawable/profile"
            android:scaleType="fitCenter"
            android:contentDescription="Foto profil mahasiswa" />

        <!-- Judul Profil -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="PROFIL MAHASISWA"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#393341" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Informasi Mahasiswa"
            android:textSize="14sp"
            android:textColor="#796B89" />

        <!-- Kartu Informasi -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:background="#FFFFFF"
            android:orientation="vertical"
            android:padding="20dp"
            android:elevation="4dp">

            <!-- Nama -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="NAMA LENGKAP"
                android:textSize="12sp"
                android:textColor="#796B89" />

            <TextView
                android:id="@+id/tvNama"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Rustita Ayuni"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#302A38" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:background="#EEE8F5" />

            <!-- NIM -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="NOMOR INDUK MAHASISWA"
                android:textSize="12sp"
                android:textColor="#796B89" />

            <TextView
                android:id="@+id/tvNim"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="6304240010"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#302A38" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:background="#EEE8F5" />

            <!-- Email -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ALAMAT EMAIL"
                android:textSize="12sp"
                android:textColor="#796B89" />

            <TextView
                android:id="@+id/tvEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="rustitaayuni@gmail.com"
                android:textSize="14sp"
                android:textColor="#302A38"
                android:textIsSelectable="true" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>